{
  "name": "zerotier-one-api-spec",
  "repository": "https://github.com/zerotier/zerotier-one-api-spec",
  "scripts": {
    "start": "run-s build watch",
    "test": "tsc --noEmit && borp",
    "build": "run-s pre-compile compile lint build:*",
    "lint": "run-p lint:*",
    "pre-compile": "run-p check-deps format-spec format-code variables",
    "build:doc-html": "redocly build-docs tsp-output/@typespec/openapi3/openapi.yaml -o ./dist/index.html",
    "pretest": "openapi-typescript tsp-output/@typespec/openapi3/openapi.yaml -o /tmp/schema.ts",
    "clean": "rm -rf dist tsp-output",
    "compile": "tsp compile ./main.tsp",
    "format-spec": "tsp format **/*.tsp",
    "format-code": "prettier --write **/*.ts",
    "lint:openapi": "redocly lint tsp-output/@typespec/openapi3/openapi.yaml",
    "lint:code": "eslint .",
    "release": "release-it --ci --no-increment",
    "variables": "printf 'alias Version = \"%s\";\n' $npm_package_version > variables.tsp",
    "watch": "run-p watch:*",
    "watch:compile": "npm run compile -- --watch",
    "check-deps": "knip --dependencies",
    "watch:docs": "node --watch-path=./tsp-output/@typespec/openapi3 ./node_modules/@redocly/cli/bin/cli.js build-docs tsp-output/@typespec/openapi3/openapi.yaml -o ./dist/index.html"
  },
  "version": "1.2.0",
  "type": "module",
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.83.0",
    "@types/node": "^24.19.4",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@typespec/compiler": "^1.18.0",
    "@typespec/json-schema": "^1.18.0",
    "@typespec/openapi": "^1.18.0",
    "@typespec/openapi3": "^1.18.0",
    "@typespec/prettier-plugin-typespec": "^1.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "auto-changelog": "^2.7.0",
    "borp": "^1.0.1",
    "eslint": "^10.15.0",
    "knip": "^6.48.0",
    "npm-run-all2": "^9.1.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "openapi-typescript-helpers": "^0.1.0",
    "prettier": "^3.10.1",
    "release-it": "^21.1.3",
    "semver": "^7.8.6",
    "testcontainers": "^12.2.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "glob": "^14.0.6",
    "test-exclude": {
      "minimatch": "^11.0.9"
    }
  }
}
